<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Read local audio. Android 13+ uses granular media perm; older uses READ_EXTERNAL_STORAGE. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Deleting a track's file on Android 8-10, which have no system delete prompt
         (Android 11+ uses MediaStore.createDeleteRequest instead; see TrackDeleter).
         requestLegacyExternalStorage below lets this work on Android 10 as well. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Foreground playback service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets the full-screen notification in LockScreenControlLauncher actually launch
         LockScreenControlActivity over the lock screen, instead of just sitting as a
         normal notification. Normal-granted at install on most versions; Android 14+
         can still revoke it for an app it doesn't consider a dialer/alarm app, in which
         case the notification posts but never launches. Settings > Apps > Special app
         access > Full screen intent lets the user re-grant it by hand. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".SimpleSoundApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SimpleSound">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SimpleSound">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The lock-screen "edge control bar" surface (Settings > Edge control bar).
             showWhenLocked lets it draw over a secure keyguard, the only mechanism
             Android still allows for this (see LockScreenControlLauncher's doc
             comment for why a plain overlay window doesn't work). singleInstance +
             excludeFromRecents: PlaybackService launches it fresh each qualifying
             screen-on rather than ever resuming a lingering instance (see the
             Activity's doc comment). Not exported: only PlaybackService (this app)
             ever sends ACTION_SHOW_LOCK_CONTROL. -->
        <activity
            android:name=".LockScreenControlActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:theme="@style/Theme.SimpleSound">
            <intent-filter>
                <action android:name="com.simplesound.app.SHOW_LOCK_CONTROL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- tools:ignore="Instantiatable": known Lint false positive when
             @AndroidEntryPoint is applied to a Service. Lint's inheritance check
             gets confused by the Hilt-generated Hilt_PlaybackService base class;
             PlaybackService still genuinely extends MediaSessionService. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- WorkManager's default initializer is disabled because SimpleSoundApp
             implements Configuration.Provider to supply a HiltWorkerFactory, so
             LibrarySyncWorker (@HiltWorker) can be constructor-injected. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
