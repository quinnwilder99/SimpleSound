            verticalArrangement = Arrangement.spacedBy(4.dp)
        ) {
            // ---- Now playing ----
            item { SectionLabel("Now playing") }
            item {
                SettingsRow(
                    title = "Accent color",
                    subtitle = "Choose the app's highlight color",
                    onClick = onAccentColor
