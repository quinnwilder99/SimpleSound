            }
            item { Spacer(Modifier.size(16.dp)) }

            // ---- Playback ----
            item { SectionLabel("Playback") }
            item {
                ToggleRow(
                    title = "Crossfade",
                    subtitle = "Smooth transitions between tracks",
                    checked = false,
                    onCheckedChange = { /* TODO */ }
                )
            }
            item {
                ToggleRow(
                    title = "Gapless playback",
                    subtitle = "Play tracks without pauses",
                    checked = false,
                    onCheckedChange = { /* TODO */ }
                )
            }
            item {
                SettingsRow(
                    title = "Audio quality",
                    subtitle = "Streaming and download quality",
                    onClick = { /* TODO */ }
                )
            }
            item {
                ToggleRow(
                    title = "Auto-download on Wi-Fi",
                    subtitle = "Save new tracks for offline use",
                    checked = false,
                    onCheckedChange = { /* TODO */ }
                )
            }
            item { Spacer(Modifier.size(16.dp)) }

            // ---- Display ----
            item { SectionLabel("Display") }
            item {
                SettingsRow(
                    title = "Theme",
                    subtitle = "Light, dark or system default",
                    onClick = { /* TODO */ }
                )
            }
            item {
                SettingsRow(
                    title = "Lock screen artwork",
                    subtitle = "Show artwork on the lock screen",
                    onClick = { /* TODO */ }
                )
            }
            item {
                ToggleRow(
                    title = "Show track numbers",
                    subtitle = "Number tracks in lists",
                    checked = false,
                    onCheckedChange = { /* TODO */ }
                )
            }
            item { Spacer(Modifier.size(16.dp)) }

            // ---- Notifications ----
            item { SectionLabel("Notifications") }
            item {
                ToggleRow(
                    title = "Playback notifications",
                    subtitle = "Show play/pause controls in the shade",
                    checked = true,
                    onCheckedChange = { /* TODO */ }
                )
            }
            item {
                SettingsRow(
                    title = "Notification channels",
                    subtitle = "Manage which alerts you receive",
                    onClick = { /* TODO */ }
                )
            }
            item { Spacer(Modifier.size(16.dp)) }

            // ---- Library ----
            item { SectionLabel("Library") }
            item {
                SettingsRow(
                    title = "Scan device for music",
                    subtitle = "Re-scan your local library",
                    onClick = { /* TODO */ }
                )
            }
            item {
                SettingsRow(
                    title = "Excluded folders",
                    subtitle = "Hide folders from your library",
                    onClick = { /* TODO */ }
                )
            }
            item {
                SettingsRow(
                    title = "Cache",
                    subtitle = "Manage downloaded and cached media",
                    onClick = { /* TODO */ }
                )
            }
            item { Spacer(Modifier.size(16.dp)) }

            // ---- About ----
            item { SectionLabel("About") }
            item {
                SettingsRow(
                    title = "About simpleSOUND",
