root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = 120
# Compose composables are PascalCase by convention, not the lowerCamelCase ktlint
# otherwise expects for functions.
ktlint_function_naming_ignore_when_annotated_with = Composable
# The codebase consistently uses the standard Kotlin "_backing / public" property
# idiom (_tracks -> tracks, _queue -> queue, ...) throughout; ktlint's default
# property-naming rule rejects the leading underscore on the private half of it.
ktlint_standard_property-naming = disabled
